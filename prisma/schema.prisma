// Prisma schema - Jota Studio + KardoJota (banco compartilhado)
// Jota Studio: ferramenta interna da Jô (gestão de todos os clientes)
// KardoJota: espaço de produção usado com cada cliente (kanban, aprovações, pedidos)
// Apenas o Jota Studio é construído nesta fase; o modelo já cobre as duas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum StageAwaiting {
  STUDIO
  CLIENT
}

enum CardPriority {
  BAIXA
  MEDIA
  ALTA
}

enum CommentAuthorType {
  STAFF
  CLIENT
}

enum ApprovalStatus {
  PENDENTE
  APROVADO
  AJUSTES
}

enum IdeaSource {
  STUDIO
  CLIENT_REQUEST
}

enum IdeaStatus {
  PENDING
  CONVERTED
}

enum TaskStatus {
  PENDENTE
  CONCLUIDA
}

enum StrategyKey {
  POSICIONAMENTO
  PERSONA
  TOM_DE_VOZ
  PILARES
}

enum CustomPageType {
  TEXT
  LIST
  FOLDER
}

// ---------- Identidade ----------

model StaffUser {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarFileId String?
  avatarFile   File?    @relation("StaffAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdClients    Client[]           @relation("ClientCreatedBy")
  cardsCreated      ContentCard[]      @relation("CardCreatedBy")
  cardComments      CardComment[]
  stageChanges      CardStageHistory[]
  ideasCreated      IdeaBank[]
  uploadedFiles     File[]             @relation("FileUploadedBy")
  internalTasks     InternalTask[]
}

model ClientContact {
  id         String   @id @default(uuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  authUserId String?
  createdAt  DateTime @default(now())
}

// ---------- Clientes ----------

model Client {
  id           String       @id @default(uuid())
  name         String
  contactName  String?
  contactEmail String?
  contactPhone String?
  service      String?
  status       ClientStatus @default(ACTIVE)
  createdById  String?
  createdBy    StaffUser?   @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  contacts        ClientContact[]
  stages          PipelineStage[]
  pillars         ContentPillar[]
  cards           ContentCard[]
  ideas           IdeaBank[]
  strategyPages   StrategyPage[]
  documentFolders DocumentFolder[]
  documents       Document[]
  notes           Note[]
  internalTasks   InternalTask[]
  customPages     CustomPage[]
}

// ---------- Produção (KardoJota) ----------

model PipelineStage {
  id        String        @id @default(uuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  color     String?
  awaiting  StageAwaiting @default(STUDIO)
  isFinal   Boolean       @default(false)
  createdAt DateTime      @default(now())

  cards            ContentCard[]
  stageHistoryFrom CardStageHistory[] @relation("FromStage")
  stageHistoryTo   CardStageHistory[] @relation("ToStage")

  @@index([clientId, position])
}

model ContentPillar {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  color       String?
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  cards ContentCard[]
  ideas IdeaBank[]
}

model ContentCard {
  id            String        @id @default(uuid())
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  stageId       String
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  title         String
  format        String?
  channel       String?
  pillarId      String?
  pillar        ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  dueDate       DateTime?
  priority      CardPriority  @default(MEDIA)
  script        String?
  caption       String?
  internalNotes String?
  visibleToClient Boolean     @default(false)
  position      Float         @default(0)
  createdById   String?
  createdBy     StaffUser?    @relation("CardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  attachments  CardAttachment[]
  comments     CardComment[]
  approvals    CardApproval[]
  stageHistory CardStageHistory[]
  ideaOrigin   IdeaBank?          @relation("IdeaConverted")

  @@index([clientId, stageId])
  @@index([clientId, dueDate])
}

model CardAttachment {
  id        String      @id @default(uuid())
  cardId    String
  card      ContentCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fileId    String
  file      File        @relation("CardAttachmentFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
}

model CardComment {
  id         String            @id @default(uuid())
  cardId     String
  card       ContentCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  authorType CommentAuthorType @default(STAFF)
  authorId   String?
  author     StaffUser?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String?
  body       String
  createdAt  DateTime          @default(now())
}

model CardApproval {
  id          String         @id @default(uuid())
  cardId      String
  card        ContentCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  status      ApprovalStatus @default(PENDENTE)
  requestedAt DateTime       @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  notes       String?
}

model CardStageHistory {
  id          String         @id @default(uuid())
  cardId      String
  card        ContentCard    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   PipelineStage? @relation("FromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String
  toStage     PipelineStage  @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   StaffUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime       @default(now())
}

// ---------- Banco de ideias / pedidos de material ----------

model IdeaBank {
  id              String         @id @default(uuid())
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  format          String?
  pillarId        String?
  pillar          ContentPillar? @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  source          IdeaSource     @default(STUDIO)
  status          IdeaStatus     @default(PENDING)
  convertedCardId String?        @unique
  convertedCard   ContentCard?   @relation("IdeaConverted", fields: [convertedCardId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       StaffUser?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
}

// ---------- Estratégia ----------

model StrategyPage {
  id        String      @id @default(uuid())
  clientId  String
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  key       StrategyKey
  content   String      @default("")
  updatedAt DateTime    @updatedAt

  @@unique([clientId, key])
}

// ---------- Documentos e contratos ----------

model DocumentFolder {
  id             String           @id @default(uuid())
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  parentFolderId String?
  parentFolder   DocumentFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id], onDelete: Cascade)
  childFolders   DocumentFolder[] @relation("FolderHierarchy")
  name           String
  createdAt      DateTime         @default(now())

  documents Document[]
}

model Document {
  id                 String          @id @default(uuid())
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  folderId           String?
  folder             DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  fileId             String
  file               File            @relation("DocumentFile", fields: [fileId], references: [id], onDelete: Cascade)
  name               String
  isContract         Boolean         @default(false)
  contractExpiresAt  DateTime?
  uploadedById       String?
  createdAt          DateTime        @default(now())
}

// ---------- Anotações ----------

model Note {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  noteDate  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments NoteAttachment[]
}

model NoteAttachment {
  id        String   @id @default(uuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileId    String
  file      File     @relation("NoteAttachmentFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ---------- Tarefas internas ----------

model InternalTask {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    CardPriority @default(MEDIA)
  status      TaskStatus   @default(PENDENTE)
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   StaffUser?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  completedAt DateTime?
}

// ---------- Páginas personalizadas ----------

model CustomPage {
  id        String         @id @default(uuid())
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      CustomPageType
  title     String
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  textContent CustomPageTextContent?
  listItems   CustomPageListItem[]
  files       CustomPageFile[]

  @@index([clientId, position])
}

model CustomPageTextContent {
  pageId  String     @id
  page    CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  content String     @default("")
}

model CustomPageListItem {
  id        String     @id @default(uuid())
  pageId    String
  page      CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean    @default(false)
  position  Int        @default(0)
  createdAt DateTime   @default(now())
}

model CustomPageFile {
  id        String     @id @default(uuid())
  pageId    String
  page      CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fileId    String
  file      File       @relation("CustomPageFile", fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
}

// ---------- Armazenamento de arquivos (bytea no Postgres) ----------

model File {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String
  sizeBytes    Int
  data         Bytes
  uploadedById String?
  uploadedBy   StaffUser? @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  cardAttachments CardAttachment[]   @relation("CardAttachmentFile")
  documents       Document[]         @relation("DocumentFile")
  noteAttachments NoteAttachment[]   @relation("NoteAttachmentFile")
  customPageFiles CustomPageFile[]   @relation("CustomPageFile")
  staffAvatars    StaffUser[]        @relation("StaffAvatar")
}
